{
  "name": "portfolio-ai-source-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsx scripts/portfolio-knowledge/publish-hosted.mts && next build --webpack",
    "start": "next start",
    "preview:local": "tsx scripts/portfolio-knowledge/preview-local.mts",
    "preview:chat": "tsx scripts/portfolio-chat/preview-local.mts",
    "pretest:offline": "node --input-type=module -e \"import { prepareEmbeddingModel } from './lib/portfolio-chat/embedding-model.mjs'; await prepareEmbeddingModel()\"",
    "test:offline": "tsx --test scripts/portfolio-knowledge/contract.test.mts scripts/portfolio-knowledge/rendered-review.test.mts scripts/portfolio-chat/chat-adapter.test.mts scripts/portfolio-chat/release-boundaries.test.mts scripts/portfolio-chat/atlas-security.test.mts scripts/portfolio-chat/local-access.test.mts scripts/portfolio-chat/preview-access.test.mts scripts/portfolio-chat/preview-local.test.mts scripts/portfolio-chat/boundaries.test.mts scripts/portfolio-chat/provider-regression.test.mts scripts/portfolio-chat/multilingual-safety.test.mts scripts/portfolio-chat/hybrid-retrieval.test.mts",
    "test:integration": "node scripts/test-atlas-integration.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@huggingface/tokenizers": "0.2.0",
    "@orama/orama": "3.1.18",
    "@orama/tokenizers": "3.1.18",
    "ai": "7.0.166",
    "lucide-react": "1.61.0",
    "next": "16.4.6",
    "onnxruntime-node": "1.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "puppeteer": "25.18.1",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
