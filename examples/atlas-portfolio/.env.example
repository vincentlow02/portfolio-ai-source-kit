# Model Studio pay-as-you-go endpoint and credentials. Keep secrets server-only.
PORTFOLIO_AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-flash
QWEN_JSON_MODE=schema
QWEN_ENABLE_THINKING=

# Required for all model calls. Apply the included SQL first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORTFOLIO_AI_QUOTA_PER_MINUTE=
PORTFOLIO_AI_QUOTA_PER_DAY=
PORTFOLIO_AI_DAILY_BUDGET_USD=
PORTFOLIO_AI_INPUT_USD_PER_MILLION=
PORTFOLIO_AI_OUTPUT_USD_PER_MILLION=

# Optional local access. The bundled dev script binds to loopback.
PORTFOLIO_AI_LOCAL_DEV=0
PORTFOLIO_AI_ACCESS_TOKEN=

# Public deployment requires explicit enablement and your exact HTTPS origin.
PORTFOLIO_AI_PUBLIC_ENABLED=0
PORTFOLIO_AI_PUBLIC_ORIGIN=
# Enable only after all Vercel preview URLs have Deployment Protection.
PORTFOLIO_AI_PROTECTED_PREVIEW=0
