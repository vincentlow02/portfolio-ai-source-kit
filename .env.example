# Set these in the Hosted assistant project's environment.
PORTFOLIO_SITE_ORIGIN=https://portfolio.example.com
PORTFOLIO_SOURCE_PATHS=/,/projects

# Optional production-only question logging. See docs/security.md.
# PORTFOLIO_HOSTED_QUESTION_LOG=1
# PORTFOLIO_HOSTED_QUESTION_LOG_SUPABASE_URL=
# PORTFOLIO_HOSTED_QUESTION_LOG_SUPABASE_SECRET_KEY=

# Enable model replies and choose one provider block. See the Firewall setup in README.md.
# PORTFOLIO_HOSTED_MODEL=1

# Qwen
# PORTFOLIO_AI_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=

# OpenAI
# PORTFOLIO_AI_PROVIDER=openai
# OPENAI_API_KEY=
# PORTFOLIO_AI_MODEL=

# Vercel AI Gateway
# PORTFOLIO_AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=
# PORTFOLIO_AI_MODEL=
