# Public website and the exact page paths you approve for the assistant.
PORTFOLIO_SITE_ORIGIN=https://portfolio.example.com
PORTFOLIO_SOURCE_PATHS=/,/projects

# Hybrid excerpts by default. Set to 1 after adding Qwen credentials and a quota rule.
PORTFOLIO_HOSTED_MODEL=0
QWEN_API_KEY=
QWEN_BASE_URL=
# Optional Qwen overrides. These are the hosted defaults.
QWEN_MODEL=qwen3.7-flash
QWEN_JSON_MODE=object
QWEN_ENABLE_THINKING=false

# Optional Supabase quota backend. Leave these blank for the Vercel Firewall path.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PORTFOLIO_AI_QUOTA_PER_MINUTE=
PORTFOLIO_AI_QUOTA_PER_DAY=
PORTFOLIO_AI_DAILY_BUDGET_USD=
PORTFOLIO_AI_INPUT_USD_PER_MILLION=
PORTFOLIO_AI_OUTPUT_USD_PER_MILLION=
